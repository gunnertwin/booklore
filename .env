# Local dev ports
BACKEND_PORT=8080
FRONTEND_PORT=4200
DB_PORT=3366
REMOTE_DEBUG_PORT=5005
PIPER_PORT=5000

# Reader TTS
TTS_ENABLED=true
TTS_MAX_TEXT_LENGTH=1800

# Azure Speech (set key + region/endpoint)
TTS_AZURE_ENABLED=true
TTS_AZURE_API_KEY=
TTS_AZURE_REGION=
TTS_AZURE_ENDPOINT=
TTS_AZURE_DEFAULT_VOICE=en-US-AvaNeural

# Google Cloud Text-to-Speech (set key)
TTS_GOOGLE_ENABLED=true
TTS_GOOGLE_API_KEY=
TTS_GOOGLE_ENDPOINT=https://texttospeech.googleapis.com
TTS_GOOGLE_DEFAULT_VOICE=en-US-Neural2-F

# Piper (open-source local TTS server)
TTS_PIPER_ENABLED=true
TTS_PIPER_BASE_URL=http://piper:5000
TTS_PIPER_DEFAULT_VOICE=
